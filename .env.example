# amagi-crm settings for Docker Compose. Copy to .env, then append fresh secrets:
#   docker run --rm amagi-crm keygen --postgres >> .env
# That adds AMAGI_CRM_ENCRYPTION_KEYS, AMAGI_CRM_SECRET_KEY and POSTGRES_PASSWORD.
# Back up .env separately from the database. Without the keys, encrypted fields are unreadable.

AMAGI_CRM_TIMEZONE=America/New_York
AMAGI_CRM_WORKING_HOURS=mon-fri 09:00-17:00
AMAGI_CRM_SLOT_MINUTES=30

# Public self-booking page at /book (rate-limited, open slots only). 1 to turn on.
AMAGI_CRM_PUBLIC_BOOKING=0
# Show appointment titles in the .ics calendar feed instead of "Busy". 1 to turn on.
AMAGI_CRM_FEED_DETAILS=0

# Host port for the web UI (bound to 127.0.0.1).
AMAGI_CRM_PORT=8000
